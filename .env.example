# Private live tracking — existing Neon database and managed authentication
# Use a restricted runtime role, never the database-owner connection string.
TRACKING_DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
TRACKING_OWNER_EMAIL=
# Optionally pin the verified Neon user ID after the first owner sign-in.
TRACKING_OWNER_ID=
# Public community board — a separate restricted role and cookie secret.
# Never reuse the private tracking role or secret; use distinct preview values.
BOARD_DATABASE_URL=
BOARD_COOKIE_SECRET=
# Public live origin used for recipient links, including invitations from previews.
VITE_TRACKING_SHARE_ORIGIN=

# Private Survival LLM — server only; existing Neon owner sign-in is required.
# Exact HTTPS Modal gateway origin, without a path. No VITE_ prefix.
# Model/library provisioning is separate; see docs/survival-server-setup.md.
SURVIVAL_SERVER_URL=

# Legacy optional OpenAI service — separate from Survival LLM.
# Current inventory cards use local rules; private chat has no OpenAI fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Legacy Supabase cloud sync (optional; not used by live tracking)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Weather API - OpenWeatherMap (required for live weather)
OPENWEATHERMAP_API_KEY=your-api-key

# News API - GNews (required for live news)
GNEWS_API_KEY=your-api-key

# Smart Home - Tactacam Reveal (optional)
TACTACAM_CLIENT_ID=
TACTACAM_CLIENT_SECRET=

# Smart Home - EyezOn (optional)
EYEZON_API_KEY=

# Google Nest — optional, server-only. See docs/google-nest-setup.md.
# Use the Device Access project ID, not the Google Cloud project ID.
GOOGLE_NEST_CLIENT_ID=
GOOGLE_NEST_CLIENT_SECRET=
GOOGLE_NEST_PROJECT_ID=
GOOGLE_NEST_REDIRECT_URI=https://prepvault-xi.vercel.app/api/nest?action=callback

# Server-only AES-256 key (64 hex characters), unique per environment.
# Encrypts private REVEAL/EyezOn/Nest connection cookies; never use a VITE_ prefix.
SURVEILLANCE_COOKIE_KEY=
