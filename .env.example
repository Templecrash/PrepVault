# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Weather API - OpenWeatherMap (required for live weather)
OPENWEATHERMAP_API_KEY=your-api-key

# News API - GNews (required for live news)
GNEWS_API_KEY=your-api-key

# LaunchFury Analytics (required)
# Browser write key (public; VITE_ is exposed to the browser)
VITE_LAUNCHFURY_ANALYTICS_WRITE_KEY=
# Server write key (server-only, never expose to the browser)
LAUNCHFURY_ANALYTICS_SERVER_KEY=

# Smart Home - Tactacam Reveal (optional)
TACTACAM_CLIENT_ID=
TACTACAM_CLIENT_SECRET=

# Smart Home - EyezOn (optional)
EYEZON_API_KEY=

# Smart Home - Google Nest (optional)
GOOGLE_NEST_CLIENT_ID=
GOOGLE_NEST_CLIENT_SECRET=
